<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Supplier Cost Form View -->
    <record id="view_supplier_cost_form" model="ir.ui.view">
        <field name="name">joiasmax.supplier.cost.form</field>
        <field name="model">joiasmax.supplier.cost</field>
        <field name="arch" type="xml">
            <form string="Supplier Cost">
                <header>
                    <button name="action_set_as_preferred"
                            string="Set as Preferred"
                            type="object"
                            class="btn-primary"
                            invisible="is_preferred_supplier"/>
                    <field name="is_current" widget="statusbar" statusbar_visible="current,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_product"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cubes">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View Product</span>
                            </div>
                        </button>
                        <button name="action_view_supplier"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-building">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View Supplier</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Preferred" bg_color="bg-success" invisible="not is_preferred_supplier"/>

                    <group name="main_group">
                        <group name="product_supplier_info" string="Product &amp; Supplier">
                            <field name="product_id"/>
                            <field name="supplier_id" domain="[('supplier_rank', '>', 0)]"/>
                            <field name="is_preferred_supplier"/>
                        </group>

                        <group name="cost_info" string="Cost Information">
                            <field name="unit_cost_brl" widget="monetary"/>
                            <field name="currency_id"/>
                        </group>
                    </group>

                    <group name="validity_group">
                        <group name="validity_dates" string="Validity Period">
                            <field name="valid_from"/>
                            <field name="valid_until"/>
                            <field name="is_current" readonly="1"/>
                        </group>

                        <group name="order_terms" string="Order Terms">
                            <field name="minimum_order_quantity"/>
                            <field name="lead_time_days"/>
                            <field name="payment_terms"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="notes" string="Notes">
                            <field name="notes" placeholder="Supplier-specific notes, quality information, etc..."/>
                        </page>

                        <page name="audit" string="Audit Info">
                            <group>
                                <field name="created_by_user_id" readonly="1"/>
                                <field name="create_date" readonly="1"/>
                                <field name="write_date" readonly="1"/>
                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Supplier Cost List View -->
    <record id="view_supplier_cost_tree" model="ir.ui.view">
        <field name="name">joiasmax.supplier.cost.list</field>
        <field name="model">joiasmax.supplier.cost</field>
        <field name="arch" type="xml">
            <list string="Supplier Costs" decoration-success="is_current == True and is_preferred_supplier == True" decoration-info="is_current == True" decoration-muted="is_current == False">
                <field name="product_id"/>
                <field name="supplier_id"/>
                <field name="unit_cost_brl" widget="monetary"/>
                <field name="valid_from"/>
                <field name="valid_until"/>
                <field name="is_current" widget="boolean_toggle"/>
                <field name="is_preferred_supplier" widget="boolean_toggle"/>
                <field name="lead_time_days" optional="show"/>
                <field name="minimum_order_quantity" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Supplier Cost Search View -->
    <record id="view_supplier_cost_search" model="ir.ui.view">
        <field name="name">joiasmax.supplier.cost.search</field>
        <field name="model">joiasmax.supplier.cost</field>
        <field name="arch" type="xml">
            <search string="Supplier Costs">
                <field name="product_id"/>
                <field name="supplier_id"/>

                <filter name="current_costs" string="Current"
                        domain="[('is_current', '=', True)]"/>
                <filter name="expired_costs" string="Expired"
                        domain="[('is_current', '=', False)]"/>
                <filter name="preferred_suppliers" string="Preferred Suppliers"
                        domain="[('is_preferred_supplier', '=', True)]"/>

                <separator/>
                <filter name="valid_today" string="Valid Today"
                        domain="[('valid_from', '&lt;=', context_today()), '|', ('valid_until', '&gt;=', context_today()), ('valid_until', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_supplier" string="Supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter name="group_validity" string="Valid From" context="{'group_by': 'valid_from'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Supplier Cost Action -->
    <record id="action_supplier_cost" model="ir.actions.act_window">
        <field name="name">Supplier Costs</field>
        <field name="res_model">joiasmax.supplier.cost</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current_costs': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create supplier cost record
            </p>
            <p>
                Track costs from different suppliers over time. Set preferred suppliers for automatic cost selection.
            </p>
        </field>
    </record>

</odoo>
