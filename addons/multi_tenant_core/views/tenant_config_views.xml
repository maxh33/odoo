<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tenant Configuration Tree View -->
        <record id="view_tenant_config_tree" model="ir.ui.view">
            <field name="name">multi_tenant.config.tree</field>
            <field name="model">multi_tenant.config</field>
            <field name="arch" type="xml">
                <tree string="Tenant Configurations">
                    <field name="name"/>
                    <field name="subdomain"/>
                    <field name="business_type"/>
                    <field name="domain"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Tenant Configuration Form View -->
        <record id="view_tenant_config_form" model="ir.ui.view">
            <field name="name">multi_tenant.config.form</field>
            <field name="model">multi_tenant.config</field>
            <field name="arch" type="xml">
                <form string="Tenant Configuration">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                                <field name="active" widget="boolean_button" options="{&quot;terminology&quot;: &quot;archive&quot;}"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="subdomain"/>
                                <field name="business_type"/>
                            </group>
                            <group>
                                <field name="database_name"/>
                                <field name="domain"/>
                                <field name="company_id"/>
                            </group>
                        </group>
                        <group>
                            <field name="api_key" password="True"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tenant Configuration Search View -->
        <record id="view_tenant_config_search" model="ir.ui.view">
            <field name="name">multi_tenant.config.search</field>
            <field name="model">multi_tenant.config</field>
            <field name="arch" type="xml">
                <search string="Search Tenants">
                    <field name="name"/>
                    <field name="subdomain"/>
                    <field name="business_type"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Business Type" name="business_type" context="{'group_by': 'business_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Tenant Configuration Action -->
        <record id="action_tenant_config" model="ir.actions.act_window">
            <field name="name">Tenant Configurations</field>
            <field name="res_model">multi_tenant.config</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_tenant_config_search"/>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first tenant configuration
                </p>
                <p>
                    Configure tenants for your multi-tenant Odoo platform. Each tenant represents a separate business with its own database and domain.
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_multi_tenant_root" name="Multi-Tenant" sequence="100" web_icon="multi_tenant_core,static/description/icon.png"/>
        <menuitem id="menu_tenant_config" name="Tenant Configurations" parent="menu_multi_tenant_root" action="action_tenant_config" sequence="10"/>
    </data>
</odoo>
