# Enforce LF line endings for all text files
# Prevents CRLF/LF conversion issues across Windows/Linux
* text=auto eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.gz binary
*.xls binary
*.xlsx binary
